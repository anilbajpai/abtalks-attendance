# Google OAuth (login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Sheets (attendance storage)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""

# NextAuth — must be a real URL, never empty.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (or your custom domain). Do not leave this blank.
# Do not set NEXTAUTH_URL to localhost on Vercel.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# Database (disabled — uncomment to re-enable Prisma/Postgres)
# DATABASE_URL="postgresql://user:password@host:5432/abtalks?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/abtalks?sslmode=require"
